# ==============================================================================
# SHILLSTORE - ENVIRONMENT CONFIGURATION (TRACKING & MAPS)
# ==============================================================================
# Salin file ini menjadi .env.local untuk mengisi kredensial API asli Anda.
# cp .env.example .env.local
# ==============================================================================

# 1. GOOGLE MAPS API KEY (Opsional)
# Digunakan untuk menampilkan Google Maps Embed resmi dengan API Key kustom.
# Jika tidak diisi, sistem tetap dapat menampilkan Google Maps Place Embed secara otomatis.
# Dapatkan API Key di: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 2. BINDERBYTE COURIER TRACKING API KEY (Opsional untuk data resi kurir real-time)
# Mendukung pengecekan resi asli untuk JNE, J&T, SiCepat, AnterAja, Ninja, POS, dll.
# Dapatkan API Key di: https://binderbyte.com
# Rute API Next.js di /api/tracking akan memanggil endpoint ini secara server-side
# sehingga secret API key Anda tidak akan pernah bocor ke frontend.
BINDERBYTE_API_KEY=

# 3. BITESHIP TRACKING API KEY (Alternatif untuk agregator logistik)
# Dapatkan API Key di: https://biteship.com
BITESHIP_API_KEY=
